# Stripe Crypto Onramp — REQUIRED to buy SOL.
# Get these from a Stripe account with Crypto Onramp enabled
# (https://stripe.com/crypto — currently a gated program you apply for).
# Without STRIPE_SECRET_KEY set, the Buy flow returns a clear
# "Stripe is not configured" error instead of doing anything.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Solana — optional, defaults to the public mainnet-beta RPC endpoint if unset.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta

# Off-ramp provider (Kado / Coinbase Offramp / MoonPay) — REQUIRED to sell SOL.
# Without OFFRAMP_PROVIDER_API_KEY set, the Sell flow returns a clear
# "off-ramp provider is not configured" error instead of doing anything.
OFFRAMP_PROVIDER_API_KEY=
OFFRAMP_PROVIDER_API_URL=https://api.kado.money
OFFRAMP_WEBHOOK_SECRET=

# Database — OPTIONAL. There are no user accounts; a wallet address is the
# only identity. Buying and selling both work with no database configured
# at all. If DATABASE_URL is set, transactions are opportunistically logged
# here so the dashboard's history list has something to show; if it's unset
# (or unreachable), the dashboard just shows "No transactions yet." and
# nothing else is affected.
DATABASE_URL=postgresql://user:password@localhost:5432/onehundredx

# Price feed — optional, defaults to CoinGecko's public API if unset.
NEXT_PUBLIC_COINGECKO_API_URL=https://api.coingecko.com/api/v3

# Public app URL (used to build webhook callback URLs for the off-ramp provider)
NEXT_PUBLIC_APP_URL=http://localhost:3000
