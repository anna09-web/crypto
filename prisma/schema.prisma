generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  BUY
  SELL
}

enum TransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// There are no user accounts — a wallet address is the only identity. This
// table is purely a best-effort activity log for the dashboard; buying and
// selling both work with no database configured at all (see the onramp/
// offramp session routes), so a write failing here never blocks a trade.
model Transaction {
  id                  String            @id @default(cuid())
  walletAddress       String
  type                TransactionType
  status              TransactionStatus @default(PENDING)
  provider            String
  providerSessionId   String?           @unique
  sourceAmount        Decimal
  sourceCurrency      String
  destinationAmount   Decimal?
  destinationCurrency String
  onChainTxSignature  String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([walletAddress])
  @@index([status])
}
